{
	"name": "niksi",
	"version": "0.3.3",
	"private": true,
	"description": "Install, review, and share agent skills",
	"type": "module",
	"bin": {
		"nik": "./src/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "bun build --compile --minify --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/index.ts --outfile dist/nik",
		"lint": "oxlint src scripts",
		"lint:fix": "oxlint --fix src scripts",
		"fmt": "oxfmt src scripts",
		"fmt:check": "oxfmt --check src scripts",
		"test": "bun test --timeout 30000",
		"release": "bumpp"
	},
	"dependencies": {
		"@clack/prompts": "1.8.0",
		"ansis": "4.3.1",
		"cac": "7.0.0",
		"cli-truncate": "6.1.1",
		"empathic": "2.0.1",
		"fast-wrap-ansi": "0.2.2",
		"linkify-it": "6.1.0",
		"markdown-it": "15.0.2",
		"pretty-bytes": "7.1.3",
		"supports-color": "11.0.0",
		"write-file-atomic": "8.0.0",
		"yaml": "2.9.0",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"@types/write-file-atomic": "4.0.3",
		"bumpp": "12.3.0",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"typescript": "7.0.2"
	}
}
